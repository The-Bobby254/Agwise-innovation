                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link]",
                    "        private Fertiliser fertiliser;",
                    "",
                    "        [Link]",
                    "        private Clock clock;",
                    "",
                    "        [Description(\"Amount (kg/ha) of fertiliser to apply\")]",
                    "        public double ApplicationAmount { get; set; }",
                    "",
                    "        [Description(\"Type of fertiliser to apply\")]",
                    "        public Fertiliser.Types FertType { get; set; }",
                    "        ",
                    "        [Description(\"Crop to be fertilised\")]",
                    "        public string CropName { get; set;}",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            Model crop = sender as Model;",
                    "            if (crop.Name.ToLower()==CropName.ToLower())",
                    "                fertiliser.Apply(Amount: ApplicationAmount, Type: FertType);",
                    "        }",
                    "    }",
                    "}",
                    ""
                  ],
                  "Parameters": [
                    {
                      "Key": "ApplicationAmount",
