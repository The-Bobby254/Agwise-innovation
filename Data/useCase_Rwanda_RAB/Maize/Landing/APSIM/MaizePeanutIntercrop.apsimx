                {
                  "$type": "Models.PMF.Plant, Models",
                  "Name": "Maize",
                  "ResourceName": "Maize",
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Shared.Utilities;",
                    "using Models.Utilities;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Clock Clock;",
                    "        [Link] Fertiliser Fertiliser;",
                    "        [Link] Summary Summary;",
                    "        [Link] Soil Soil;",
                    "        ",
                    "        [Description(\"Crop\")]",
                    "        public IPlant Crop { get; set; }",
                    "",
                    "        [Description(\"Sowing date (d-mmm)\")]",
                    "        public string SowDate { get; set; }",
                    "",
                    "        [Display(Type = DisplayType.CultivarName)]",
                    "        [Description(\"Cultivar to be sown\")]",
                    "        public string CultivarName { get; set; }",
                    "",
                    "        [Description(\"Sowing depth (mm)\")]",
                    "        public double SowingDepth { get; set; }",
                    "",
                    "        [Description(\"Row spacing (mm)\")]",
                    "        public double RowSpacing { get; set; }",
                    "",
                    "        [Description(\"Plant population (/m2)\")]",
                    "        public double Population { get; set; }",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                    "            {",
                    "                Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "Crop",
                      "Value": "[Maize]"
                    },
                    {
                      "Key": "SowDate",
                      "Value": "1-Nov"
                    },
                    {
                      "Key": "CultivarName",
                      "Value": "Dekalb_XL82"
                    },
                    {
                      "Key": "SowingDepth",
                      "Value": "30"
                    },
                    {
                      "Key": "RowSpacing",
                      "Value": "750"
                    },
                    {
                      "Key": "Population",
                      "Value": "6"
                    }
                  ],
                  "Name": "MaizeSowingRule",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using System;",
                    "using Models.Core;",
                    "using Models.PMF;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link]",
                    "        private Fertiliser fertiliser;",
                    "",
                    "        [Link]",
                    "        private Clock clock;",
                    "",
                    "        [Description(\"Amount (kg/ha) of fertiliser to apply\")]",
                    "        public double ApplicationAmount { get; set; }",
                    "",
                    "        [Description(\"Type of fertiliser to apply\")]",
                    "        public Fertiliser.Types FertType { get; set; }",
                    "        ",
                    "        [Description(\"Crop to be fertilised\")]",
                    "        public string CropName { get; set;}",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            Model crop = sender as Model;",
                    "            if (crop.Name.ToLower()==CropName.ToLower())",
                    "                fertiliser.Apply(Amount: ApplicationAmount, Type: FertType);",
                    "        }",
                    "    }",
                    "}",
                    ""
                  ],
                  "Parameters": [
                    {
                      "Key": "ApplicationAmount",
                      "Value": "160"
                    },
                    {
                      "Key": "FertType",
                      "Value": "Urea"
                    },
                    {
                      "Key": "CropName",
                      "Value": "Maize"
                    }
                  ],
                  "Name": "MaizeFertiliserRule",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils.Nutrients;",
                    "using System.Linq;",
                    "using System;",
                    "using Models.Core;",
                    "using Models.PMF;",
                    "using Models.Soils;",
                    "using Models.Soils.Nutrients;",
                    "using Models.Utilities;",
                    "using APSIM.Shared.Utilities;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link(ByName=true)] Plant Maize;",
                    "        [Link] Clock clock;",
                    "        ",
                    "        [Description(\"Harvest date (d-mmm)\")]",
                    "        public string HarvestDate { get; set; }",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (Maize.IsReadyForHarvesting)",
                    "            {",
                    "               Maize.Harvest();",
                    "               Maize.EndCrop();    ",
                    "            }",
                    "        ",
                    "        }",
                    "        ",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "HarvestDate",
                      "Value": ""
