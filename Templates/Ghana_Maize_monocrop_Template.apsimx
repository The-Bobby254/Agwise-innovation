            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Numerics;",
                "using Models.Climate;",
                "using System;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.Soils;",
                "using Models.Utilities;",
                "using Models.Interfaces;",
                "using APSIM.Shared.Utilities;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Summary Summary;",
                "        [Link] private ISoilWater waterBalance;",
                "",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "",
                "        [Description(\"Start of sowing window (d-mmm)\")]",
                "        public string StartDate { get; set; }",
                "",
                "        [Description(\"End of sowing window (d-mmm)\")]",
                "        public string EndDate { get; set; }",
                "",
                "        [Description(\"Minimum extractable soil water for sowing (mm)\")]",
                "        public double MinESW { get; set; }",
                "",
                "        [Description(\"Minimum rainfall required for sowing (mm)\")]",
                "        public double MinRain { get; set; } = 0;",
                "",
                "        [Description(\"Number of days over which rainfall is accumulated for sowing\")]",
                "        public int RainDays { get; set; } = 0;",
                "",
                "        [Display(Type = DisplayType.CultivarName)]",
                "        [Description(\"Cultivar to be sown\")]",
                "        public string CultivarName { get; set; }",
                "",
                "        [Description(\"Sowing depth (mm)\")]",
                "        public double SowingDepth { get; set; }",
                "",
                "        [Description(\"Row spacing (mm)\")]",
                "        public double RowSpacing { get; set; }",
                "",
                "        [Description(\"Plant population (/m2)\")]",
                "        public double Population { get; set; }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (Crop == null || Crop.IsAlive)",
                "                return;",
                "",
                "            bool inWindow = DateUtilities.WithinDates(StartDate, Clock.Today, EndDate);",
                "            bool enoughWater = MathUtilities.Sum(waterBalance.ESW) > MinESW;",
                "            bool enoughRain = true;",
                "",
                "            if (inWindow && enoughWater && enoughRain)",
                "            {",
                "                Summary.WriteMessage(this, \"Sowing maize\", MessageType.Diagnostic);",
                "                Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Maize]"
                },
                {
                  "Key": "StartDate",
                  "Value": "01-nov"
                },
                {
                  "Key": "EndDate",
                  "Value": "10-jan"
                },
                {
                  "Key": "MinESW",
                  "Value": "0"
                },
                {
                  "Key": "MinRain",
                  "Value": "0"
                },
                {
                  "Key": "RainDays",
                  "Value": "0"
                },
                {
                  "Key": "CultivarName",
                  "Value": "Mid"
                },
                {
                  "Key": "SowingDepth",
                  "Value": "30"
                },
                {
                  "Key": "RowSpacing",
                  "Value": "750"
                },
                {
                  "Key": "Population",
                  "Value": "6"
                }
              ],
              "Name": "MaizeManager",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.PMF.Phen;",
                "using APSIM.Shared.Utilities;",
                "using System.Xml.Serialization;",
                "using Models;",
                "using Models.PMF;",
                "using Models.Soils;",
                "using System.Text;",
                "using System.Collections.Generic;",
                "using Models.Core;",
                "using System;",
                "using Models.Soils.Nutrients;",
                "",
                "namespace Models",
                "{",
                "    [Serializable] ",
                "    public class Script : Model",
                "    {",
                "        [Link(ByName = true)] private Plant Maize;",
                "        [Link] private Zone zone;",
                "        [Link(Type = LinkType.Path, Path = \"[Maize].Phenology\")]",
                "        private Phenology phenology;",
                "                    ",
                "        ",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                "        {",
                "        }",
                "        ",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                "            {",
                "                Maize.Harvest();",
                "                Maize.EndCrop();",
                "            }",
                "        }",
                "        ",
                "        [EventSubscribe(\"DoManagementCalculations\")]",
                "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                "        {",
                "            ",
                "        }",
                "    }",
                "}",
                "       "
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Maize]"
                }
              ],
              "Name": "MaizeHarvest",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils;",
                "using System;",
                "using Models.Core;",
                "using Models.PMF;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Fertiliser fertiliser;",
                "        [Link] private Clock clock;",
                "",
                "        [Description(\"Amount (kg/ha) of fertiliser to apply\")]",
                "        public double ApplicationAmount { get; set; }",
                "",
                "        [Description(\"Type of fertiliser to apply\")]",
                "        [Display(Type = DisplayType.FertiliserType)]",
                "        public string FertType { get; set; }",
                "",
                "        [Description(\"Crop to be fertilised\")]",
                "        public string CropName { get; set; }",
                "",
                "        [Description(\"Application date (d-MMM, e.g. 01-Nov)\")]",
                "        public string ApplicationDate { get; set; }",
                "",
                "        private bool applied = false;",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (applied)",
                "                return;",
                "",
                "            string today = clock.Today.ToString(\"d-MMM\");",
                "            if (!today.Equals(ApplicationDate, StringComparison.OrdinalIgnoreCase))",
                "                return;",
                "",
                "            fertiliser.Apply(amount: ApplicationAmount, type: FertType);",
                "            applied = true;",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "ApplicationAmount",
                  "Value": "160"
                },
                {
                  "Key": "FertType",
                  "Value": "NO3N"
                },
                {
                  "Key": "CropName",
                  "Value": "Maize"
                },
                {
                  "Key": "ApplicationDate",
                  "Value": "01-Nov"
                }
              ],
              "Name": "MaizeFertiliserRule",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
    {
