            {
              "$type": "Models.Manager, Models",
              "Name": "MaizeFertiliserRule",
              "CodeArray": [
                "using Models.Soils;",
                "using System;",
                "using Models.Core;",
                "using Models.PMF;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Fertiliser fertiliser;",
                "        [Link] private Clock clock;",
                "",
                "        [Description(\"Amount (kg/ha) of fertiliser to apply\")]",
                "        public double ApplicationAmount { get; set; }",
                "",
                "        [Description(\"Type of fertiliser to apply\")]",
                "        [Display(Type = DisplayType.FertiliserType)]",
                "        public string FertType { get; set; }",
                "",
                "        [Description(\"Application date (d-MMM)\")]",
                "        public string ApplicationDate { get; set; }",
                "",
                "        private bool applied = false;",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (applied) return;",
                "            string today = clock.Today.ToString(\"d-MMM\");",
                "            if (!today.Equals(ApplicationDate, StringComparison.OrdinalIgnoreCase)) return;",
                "            fertiliser.Apply(amount: ApplicationAmount, type: FertType);",
                "            applied = true;",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {"Key": "ApplicationAmount", "Value": "160"},
                {"Key": "FertType", "Value": "DAP"},
                {"Key": "ApplicationDate", "Value": "01-Nov"}
              ],
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
